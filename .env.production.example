# FridgeFriend Production Environment Configuration

# Copy this file to .env.production, then replace placeholder values before deployment.

# === Core Application ===
# Application display name.
APP_NAME=FridgeFriend
# Release version exposed by the API.
VERSION=0.1.0
# Production must run with debug disabled.
DEBUG=false
# Logical application environment label.
APP_ENV=production

# === Database ===
# Database username for the production RDS cluster.
DB_USER=fridgefriend
# Set via AWS Secrets Manager
# Database password for the production RDS cluster.
DB_PASSWORD='${DB_PASSWORD}'
# Primary PostgreSQL database name.
DB_NAME=fridgefriend
# PostgreSQL listener port.
DB_PORT=5432
# RDS writer endpoint hostname.
RDS_ENDPOINT=fridgefriend-prod.cluster-xxxxxxxxxx.us-east-1.rds.amazonaws.com
# Async SQLAlchemy connection string used by the backend and workers.
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${RDS_ENDPOINT}:5432/fridgefriend

# === Cache & Broker ===
# ElastiCache Redis primary endpoint hostname.
ELASTICACHE_ENDPOINT=fridgefriend-prod.xxxxxx.use1.cache.amazonaws.com
# Shared Redis connection for cache, Celery, and idempotency.
REDIS_URL=redis://${ELASTICACHE_ENDPOINT}:6379/0
# Celery broker URL. Keep aligned with REDIS_URL unless split infrastructure is used.
CELERY_BROKER_URL=${REDIS_URL}
# Celery result backend URL.
CELERY_RESULT_BACKEND=${REDIS_URL}
# Idempotency persistence backend.
IDEMPOTENCY_BACKEND=redis
# Retain idempotency keys for 24 hours.
IDEMPOTENCY_TTL_SECONDS=86400

# === Authentication ===
# Disable mock authentication in production.
AUTH_MOCK=false
# Firebase project used to validate issued JWTs.
FIREBASE_PROJECT_ID=fridgefriend-prod
# In-container path for the mounted Firebase service-account JSON.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-credentials.json
# Enable Firebase Cloud Messaging push delivery.
FCM_ENABLED=true

# === Storage ===
# Use Amazon S3 instead of local development storage.
STORAGE_BACKEND=s3
# Public regional S3 API endpoint.
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# Bucket used for signed uploads and generated assets.
S3_BUCKET=fridgefriend-uploads-prod
# AWS region for all production resources.
AWS_REGION=us-east-1
# Set via AWS Secrets Manager
# AWS access key used by local production-like compose runs only.
AWS_ACCESS_KEY_ID='${AWS_ACCESS_KEY_ID}'
# Set via AWS Secrets Manager
# AWS secret access key used by local production-like compose runs only.
AWS_SECRET_ACCESS_KEY='${AWS_SECRET_ACCESS_KEY}'

# === AI/LLM ===
# Route photo parsing through the hosted LLM backend.
PHOTO_PARSER_BACKEND=llm
# Internal LiteLLM or gateway URL.
LLM_API_URL=https://litellm.labs.jb.gg
# Default production model for fridge photo parsing.
LLM_MODEL=gpt-4.1-mini
# Set via AWS Secrets Manager
# Optional API key if the LLM gateway requires explicit authentication.
LLM_API_KEY='${LLM_API_KEY}'

# === Recipe & Catalog ===
# External recipe catalog provider.
RECIPE_SOURCE=spoonacular
# Set via AWS Secrets Manager
# Spoonacular API key used for recipe lookup and enrichment.
SPOONACULAR_API_KEY='${SPOONACULAR_API_KEY}'
# Barcode lookup provider.
BARCODE_API_SOURCE=openfoodfacts

# === Observability ===
# Set via AWS Secrets Manager
# Sentry DSN for backend error and performance telemetry.
SENTRY_DSN='${SENTRY_DSN}'
# Runtime environment label reported to Sentry.
SENTRY_ENVIRONMENT=production
# Fraction of traces sampled for performance monitoring.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set via AWS Secrets Manager
# Amplitude ingestion API key for product analytics events.
AMPLITUDE_API_KEY='${AMPLITUDE_API_KEY}'

# === Cost Tracking ===
# Estimated input token cost used for unit economics reporting.
LLM_INPUT_COST_PER_1M=0.40
# Estimated output token cost used for unit economics reporting.
LLM_OUTPUT_COST_PER_1M=1.60
# Estimated per-point cost for Spoonacular usage.
SPOONACULAR_POINT_COST=0.005

# === Deployment ===
# AWS account ECR registry hosting deployable images.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# Container image tag used by docker-compose.prod.yml and ECS templates.
IMAGE_TAG=latest
# ECS cluster name for production services.
ECS_CLUSTER=fridgefriend-prod
# ECS service name for the FastAPI backend.
ECS_BACKEND_SERVICE=fridgefriend-backend
# ECS service name for the Streamlit dashboard.
ECS_DASHBOARD_SERVICE=fridgefriend-dashboard
# ECS task definition family for backend/API services.
ECS_BACKEND_TASK_FAMILY=fridgefriend-backend
# ECS task definition family for dashboard services.
ECS_DASHBOARD_TASK_FAMILY=fridgefriend-dashboard
# Public base URL for the analytics dashboard.
DASHBOARD_BASE_URL=https://dashboard.fridgefriend.app

# WARNING: Never commit this file with real values. Use .env.production.example as template.
