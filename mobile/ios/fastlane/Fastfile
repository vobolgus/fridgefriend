default_platform(:ios)

FLUTTER_ROOT = File.expand_path("../..", __dir__)
XCODEPROJ = File.join(FLUTTER_ROOT, "ios", "Runner.xcodeproj")
CI_KEYCHAIN_NAME = "fastlane_ci"
CI_KEYCHAIN_PASSWORD = "ci_keychain_password"

platform :ios do
  desc "Create a dedicated CI keychain (avoids login keychain permission popups)"
  lane :setup_ci_keychain do
    if is_ci
      create_keychain(
        name: CI_KEYCHAIN_NAME,
        password: CI_KEYCHAIN_PASSWORD,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false,
      )
    end
  end

  desc "Sync signing certificates and provisioning profiles"
  lane :sync_certs do
    if is_ci
      match(
        type: "appstore",
        readonly: true,
        keychain_name: CI_KEYCHAIN_NAME,
        keychain_password: CI_KEYCHAIN_PASSWORD,
      )
    else
      match(type: "appstore", readonly: true)
    end
  end

  desc "Build Flutter app and create IPA"
  lane :build do
    setup_ci_keychain
    sync_certs

    # Switch to manual signing for CI builds
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: "SMV4M77P8S",
      bundle_identifier: "com.suglobov.fridgefriend",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.suglobov.fridgefriend",
    )

    # Flutter build
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter", "build", "ipa",
        "--release",
        "--export-options-plist=ios/ExportOptions.plist",
        "--dart-define=API_BASE_URL=https://api.fridgefriend.lat")
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false,
    )

    # Auto-increment build number from TestFlight
    current_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.suglobov.fridgefriend",
    )
    new_build_number = (current_build + 1).to_s
    UI.message("Build number: #{current_build} → #{new_build_number}")

    setup_ci_keychain
    sync_certs

    # Switch to manual signing for CI builds
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: "SMV4M77P8S",
      bundle_identifier: "com.suglobov.fridgefriend",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.suglobov.fridgefriend",
    )

    # Flutter build with auto-incremented build number
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter", "build", "ipa",
        "--release",
        "--build-number=#{new_build_number}",
        "--export-options-plist=ios/ExportOptions.plist",
        "--dart-define=API_BASE_URL=https://api.fridgefriend.lat")
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(FLUTTER_ROOT, "build/ios/ipa/fridgefriend_mobile.ipa"),
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )

    if is_ci
      delete_keychain(name: CI_KEYCHAIN_NAME)
    end
  end

  desc "Run Flutter tests"
  lane :test do
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter", "test", "--reporter", "expanded")
    end
  end
end
